<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI Concepts & Hallucination Documentation</title>
  <style>
    :root {
      --bg-gradient: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
      --card-bg: rgba(255, 255, 255, 0.08);
      --card-border: rgba(255, 255, 255, 0.18);
      --text-main: #ffffff;
      --pink: #ff007f;
      --cyan: #00f0ff;
      --yellow: #ffe600;
      --purple: #a100ff;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: var(--bg-gradient);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 40px 20px;
      overflow-x: hidden;
    }

    h1 {
      font-size: 2.5rem;
      text-align: center;
      margin-bottom: 10px;
      background: linear-gradient(45deg, var(--cyan), var(--pink), var(--yellow));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: pulseGlow 3s infinite alternate;
    }

    p.subtitle {
      text-align: center;
      font-size: 1.1rem;
      opacity: 0.8;
      margin-bottom: 40px;
    }

    .container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 25px;
      max-width: 1100px;
      width: 100%;
      z-index: 10;
    }

    .card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 16px;
      padding: 24px;
      backdrop-filter: blur(12px);
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      position: relative;
    }

    .card:hover {
      transform: translateY(-8px);
      box-shadow: 0 12px 40px 0 rgba(0, 240, 255, 0.25);
    }

    .badge {
      display: inline-block;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: bold;
      text-transform: uppercase;
      margin-bottom: 15px;
      letter-spacing: 1px;
    }

    .card:nth-child(1) .badge { background: var(--pink); color: #fff; }
    .card:nth-child(2) .badge { background: var(--cyan); color: #000; }
    .card:nth-child(3) .badge { background: var(--yellow); color: #000; }
    .card:nth-child(4) .badge { background: var(--purple); color: #fff; }

    h2 {
      font-size: 1.3rem;
      margin-bottom: 12px;
    }

    .explanation {
      font-size: 0.95rem;
      line-height: 1.6;
      opacity: 0.9;
    }

    /* Sparkle Particle Styling */
    .sparkle {
      position: absolute;
      pointer-events: none;
      border-radius: 50%;
      animation: floatFade 1.2s ease-out forwards;
      z-index: 9999;
    }

    @keyframes floatFade {
      0% {
        opacity: 1;
        transform: translate(0, 0) scale(1) rotate(0deg);
      }
      100% {
        opacity: 0;
        transform: translate(var(--dx), var(--dy)) scale(0) rotate(180deg);
      }
    }

    @keyframes pulseGlow {
      0% { filter: drop-shadow(0 0 5px rgba(0, 240, 255, 0.4)); }
      100% { filter: drop-shadow(0 0 20px rgba(255, 0, 127, 0.8)); }
    }
  </style>
</head>
<body>

  <h1>AI Phenomena Documentation</h1>
  <p class="subtitle">Move your mouse or click anywhere for magic sparkles!</p>

  <div class="container">
    <!-- Card 1 -->
    <div class="card">
      <span class="badge">Token Count</span>
      <h2>OpenAI Tokenizer Test</h2>
      <p class="explanation">
        Pasting the sentence <em>"The quick brown fox jumps over the lazy dog."</em> into the OpenAI Tokenizer yields <strong>9 tokens</strong> because words and punctuation pieces are split into sub-word tokens.
      </p>
    </div>

    <!-- Card 2 -->
    <div class="card">
      <span class="badge">Context Overflow</span>
      <h2>Lost System Instructions</h2>
      <p class="explanation">
        In a long coding session where an entire 5,000-word software specification script was pasted into the chat history, the model eventually stopped referencing the database credentials outlined in the first paragraph because it exceeded its context window limit.
      </p>
    </div>

    <!-- Card 3 -->
    <div class="card">
      <span class="badge">Temperature Comparison</span>
      <h2>Creative Divergence</h2>
      <p class="explanation">
        Running the prompt <em>"Describe a sunset"</em> at a temperature of 0.0 produced a straightforward, repetitive description, whereas setting it to 1.0 generated a highly poetic and metaphorical interpretation of the same scene.
      </p>
    </div>

    <!-- Card 4 -->
    <div class="card">
      <span class="badge">Hallucination</span>
      <h2>Spotted in the Wild</h2>
      <p class="explanation">
        An AI assistant confidently provided a completely fabricated historical biography of a minor 19th-century inventor, which was given away by the <strong>confabulation signature</strong> (stating false facts with absolute, unhesitating certainty despite a lack of source material).
      </p>
    </div>
  </div>

  <script>
    // Colorful Sparkle Generator
    const colors = ['#ff007f', '#00f0ff', '#ffe600', '#a100ff', '#00ff88'];

    function createSparkle(x, y, isClick = false) {
      const count = isClick ? 12 : 1; // Generate more sparkles on click
      
      for (let i = 0; i < count; i++) {
        const sparkle = document.createElement('div');
        sparkle.classList.add('sparkle');

        const size = Math.random() * 8 + 4;
        const color = colors[Math.floor(Math.random() * colors.length)];

        // Random directional velocities for animation
        const angle = Math.random() * Math.PI * 2;
        const distance = isClick ? Math.random() * 80 + 20 : Math.random() * 30 + 10;
        const dx = Math.cos(angle) * distance + 'px';
        const dy = Math.sin(angle) * distance + 'px';

        sparkle.style.width = `${size}px`;
        sparkle.style.height = `${size}px`;
        sparkle.style.background = color;
        sparkle.style.boxShadow = `0 0 10px ${color}`;
        sparkle.style.left = `${x}px`;
        sparkle.style.top = `${y}px`;
        sparkle.style.setProperty('--dx', dx);
        sparkle.style.setProperty('--dy', dy);

        document.body.appendChild(sparkle);

        setTimeout(() => {
          sparkle.remove();
        }, 1200);
      }
    }

    // Mousemove sparkle trail (throttled)
    let lastTime = 0;
    window.addEventListener('mousemove', (e) => {
      const now = Date.now();
      if (now - lastTime > 40) {
        createSparkle(e.clientX, e.clientY);
        lastTime = now;
      }
    });

    // Burst sparkles on click
    window.addEventListener('click', (e) => {
      createSparkle(e.clientX, e.clientY, true);
    });
  </script>
</body>
</html>
